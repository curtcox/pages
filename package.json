{
  "name": "pages-online",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser/all.cjs",
    "check": "node scripts/check.mjs",
    "examples": "node scripts/build-examples.mjs",
    "gallery": "node scripts/render-gallery.mjs",
    "offline": "node scripts/update-offline.mjs",
    "serve": "python3 -m http.server 8000",
    "test:urls": "node tests/browser/url-state.cjs",
    "gallery:pages": "node scripts/render-page-previews.mjs",
    "docs": "node scripts/render-docs.mjs",
    "test:contracts": "playwright test --config vendor/fragment-kit-v0.3.5/testing/playwright.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "linkedom": "0.18.14",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
